{
  "name": "watch-heart-desktop",
  "version": "1.7.0",
  "description": "Receive and display heart rate from standard BLE heart rate sensors and broadcasters.",
  "main": "src/main.js",
  "author": "Codex",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "scripts": {
    "start": "electron .",
    "start:client": "electron .",
    "start:web": "node src/web-server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.watchheart",
    "productName": "Watch Heart",
    "publish": [
      {
        "provider": "github",
        "owner": "HDZ123321",
        "repo": "watch-heart-desktop"
      }
    ],
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Watch-Heart-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Watch-Heart-${version}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.healthcare-fitness",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Cross-platform BLE heart rate receiver",
      "description": "Receive and display heart rate from standard BLE heart rate sensors and broadcasters."
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
